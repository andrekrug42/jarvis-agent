# Lokal: MISTRAL_API_KEY für `agents serve` / `agents chat`
MISTRAL_API_KEY=

# Signal-REST-API (z. B. signal-cli-rest-api im Docker-Container)
SIGNAL_API_URL=http://localhost:8080
SIGNAL_PHONE_NUMBER=+49123456789
# Basic-Auth: base64-kodierter Username und base64-kodiertes Passwort (werden zu Authorization: Basic base64(user:pass))
SIGNAL_USERNAME=
SIGNAL_PASSWORD=
# Alternative: API-Key der Signal-REST-API (leer lassen, wenn Basic-Auth genutzt wird)
SIGNAL_API_KEY=
# Header/Präfix für den Key (Fallback, wenn kein Username/Passwort gesetzt ist)
SIGNAL_AUTH_HEADER=Authorization
SIGNAL_AUTH_PREFIX=Bearer

# Optional: kommaseparierte Liste von erlaubten Absendern (UUIDs oder Nummern). Leer = alle dürfen schreiben.
SIGNAL_ALLOWED_SOURCES=

# Name des Agenten (muss zum Deployment-Namen passen) und des Account-Inhabers für den Kontext
JARVIS_AGENT_NAME=jarvis
JARVIS_OWNER_NAME=Andre
