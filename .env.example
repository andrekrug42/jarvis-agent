# Lokal: MISTRAL_API_KEY für `agents serve` / `agents chat`
MISTRAL_API_KEY=

# Signal-REST-API (z. B. signal-cli-rest-api im Docker-Container)
SIGNAL_API_URL=http://localhost:8080
SIGNAL_PHONE_NUMBER=+49123456789
# Basic-Auth: base64-kodierter Username und base64-kodiertes Passwort (werden zu Authorization: Basic base64(user:pass))
SIGNAL_USERNAME=
SIGNAL_PASSWORD=
# Alternative: API-Key der Signal-REST-API (leer lassen, wenn Basic-Auth genutzt wird)
SIGNAL_API_KEY=
# Header/Präfix für den Key (Fallback, wenn kein Username/Passwort gesetzt ist)
SIGNAL_AUTH_HEADER=Authorization
SIGNAL_AUTH_PREFIX=Bearer

# Optional: kommaseparierte Liste von erlaubten Absendern (UUIDs oder Nummern). Leer = alle dürfen schreiben.
SIGNAL_ALLOWED_SOURCES=

# Optional: Allowlist für Chats (Sicherheit). Kommaseparierte Einträge:
#   dm:<uuid|nummer>   1:1-Chat mit dieser Person
#   group:<id|name>    Gruppenchat (ID oder Gruppenname)
#   <uuid> / +<nummer> / Personenname / Gruppenname  (Namen werden über /v1/contacts und /v1/groups aufgelöst)
# Leer = fail-closed: ALLE Chats werden blockiert (Owner bekommt eine DM). Beispiel: JARVIS_ALLOWED_CHATS=Andre,Melina,Jano,Magda,Anna,group:Familie Krug
JARVIS_ALLOWED_CHATS=

# Name des Agenten (muss zum Deployment-Namen passen) und des Account-Inhabers für den Kontext
JARVIS_AGENT_NAME=jarvis
JARVIS_OWNER_NAME=Andre

# User-API-Key (Mistral): Agent-Sessions dürfen nur als User gestartet werden, nicht als Service Account
JARVIS_AGENT_API_KEY=

# Autonomer Postfach-Check (gmail-Connector): Intervall in Sekunden und max. Mails pro Lauf
JARVIS_MAILBOX_INTERVAL_SECONDS=3600
JARVIS_MAILBOX_MAX_MESSAGES=10
# Signal-UUID des Account-Inhabers (bekommt die Postfach-Benachrichtigungen als 1:1-DM, nur wenn MAILS > 0)
JARVIS_OWNER_UUID=
